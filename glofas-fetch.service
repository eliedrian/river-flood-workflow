[Unit]
Description=Fetch GloFAS via lftp
Wants=network-online.target
After=network-online.target
OnFailure=failure-email-send@%n.service
StartLimitIntervalSec=20min
StartLimitBurst=79
PartOf=river-flood-workflow.target
Wants=glofas-cache-cleanup.service
After=glofas-cache-cleanup.service

[Service]
Type=oneshot
LoadCredential=password:@etcdir@/ftp_password
LoadCredential=username:@etcdir@/ftp_username
ExecStart=/bin/sh -c 'exec @bindir@/glofas-fetch -d $$(date +%%Y%%m%%d) -o @cachedir@/glofas'
#Environment="DEBUG=1"
SyslogIdentifier=glofas-fetch
Restart=on-failure
RestartMode=direct
RestartSec=15
